{"rewrites": [{"source": "/api/(.*)", "destination": "/api/index?r=$1"}, {"source": "/c/(.*)", "destination": "/client.html"}, {"source": "/app", "destination": "/app/index.html"}, {"source": "/", "destination": "/app/index.html"}], "functions": {"api/index.js": {"maxDuration": 30}}, "headers": [{"source": "/app/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Robots-Tag", "value": "noindex"}]}, {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Robots-Tag", "value": "noindex"}]}, {"source": "/download/(.*)\\.apk", "headers": [{"key": "Content-Type", "value": "application/vnd.android.package-archive"}, {"key": "Content-Disposition", "value": "attachment; filename=\"tahseel-raya.apk\""}, {"key": "Cache-Control", "value": "no-cache"}]}, {"source": "/download/version.json", "headers": [{"key": "Access-Control-Allow-Origin", "value": "*"}, {"key": "Cache-Control", "value": "no-cache"}, {"key": "Content-Type", "value": "application/json; charset=utf-8"}]}], "crons": [{"path": "/api/backup", "schedule": "0 1 * * *"}]}