{"rewrites": [{"source": "/api/(.*)", "destination": "/api/index?r=$1"}, {"source": "/c/(.*)", "destination": "/client.html"}, {"source": "/app", "destination": "/app/index.html"}, {"source": "/", "destination": "/app/index.html"}], "functions": {"api/index.js": {"maxDuration": 30}}, "headers": [{"source": "/app/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Robots-Tag", "value": "noindex"}]}, {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Robots-Tag", "value": "noindex"}]}]}